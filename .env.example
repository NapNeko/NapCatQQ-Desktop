# 中转代理常量 —— 拷贝本文件为 .env 填入真实值。
# .env 已在 .gitignore 中忽略，不会进仓库。
#
# NCD_PROXY_BASE_URL: 中转 Worker 根 URL（不含末尾 /）
# NCD_PROXY_SECRET:   Worker 端的 SHARED_SECRET（HMAC-SHA256 签名密钥）
#
# 开发环境：在此填入后，cargo build 会自动注入；缺失则走 GitHub 直连。
# CI / 发布：build-msi.yml 注入环境变量（优先级高于 .env）。
#   - BASE_URL: 可用 repository variable NCD_PROXY_BASE_URL，默认与下方一致
#   - SECRET: secrets.NCD_PROXY_SECRET 或历史名 secrets.NCD_PROXY_SHARED_SECRET
#     （build.rs 两者都认）

NCD_PROXY_BASE_URL=https://napcat-desktop.aqiaoyo.top
NCD_PROXY_SECRET=在这里填你的 SHARED_SECRET 值

# ---------------------------------------------------------------------------
# 发版说明 AI（可选，对齐旧版 script/utils/generate_changelog_ai.py）
# pnpm run release:notes:draft / pnpm run release 生成策展时读取。
# 有 key 则调模型；无 key 或 --no-ai 则规则归类。勿把真实 key 提交进仓库。
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-...
# 或
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENAI_MODEL=z-ai/glm-4.5-air:free
# 推理模型建议 ≥12000，过小会 finish=length 且 content 为空
# OPENAI_MAX_TOKENS=16000
