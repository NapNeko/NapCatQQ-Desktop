{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "enableGTKAppId": true,
        "windows": [
            {
                "label": "main",
                "title": "NapCatQQ Desktop",
                "width": 1280,
                "height": 800,
                "minWidth": 1148,
                "minHeight": 720,
                "center": true,
                "visible": false,
                "decorations": false,
                "transparent": false,
                "backgroundColor": "#211f1d",
                "shadow": true
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "appimage"],
        "category": "Utility",
        "shortDescription": "NapCatQQ / SnowLuma desktop console",
        "linux": {
            "deb": {
                "desktopTemplate": "linux/main.desktop.hbs",
                "files": {
                    "/usr/share/applications/com.napcatqq.desktop.desktop": "linux/com.napcatqq.desktop.desktop"
                }
            }
        }
    }
}
