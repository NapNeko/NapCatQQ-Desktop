{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NapCatQQ Desktop",
  "version": "3.1.3",
  "identifier": "com.napcatqq.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NapCatQQ Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 1148,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#211f1d",
        "shadow": true,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      }
    ]
  },
  "bundle": {
    "publisher": "Qiao",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "wix/locales/zh-CN.wxl"
          }
        },
        "upgradeCode": "5EBD6A58-1B0A-4700-B16F-7E3D7D62949D",
        "template": "wix/main.wxs",
        "fragmentPaths": [
          "wix/v2-orphan-cleanup.wxs"
        ],
        "componentRefs": [
          "V2OrphanCleanup",
          "V2OrphanCleanupUser"
        ]
      }
    }
  }
}