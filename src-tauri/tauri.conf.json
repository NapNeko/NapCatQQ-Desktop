{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NapCatQQ Desktop",
  "version": "3.0.0",
  "identifier": "com.napcatqq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "NapCatQQ Desktop",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      }
    ]
  }
}