{
  "name": "napcatqq-desktop-ui",
  "private": true,
  "version": "3.3.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --config src-ui/vite.config.ts",
    "test:unit": "vitest run --config src-ui/vitest.config.ts --dir src-ui",
    "test:probe": "node --test \"src-tauri/resources/metrics/*.test.mjs\"",
    "build": "tsc -p src-ui/tsconfig.json && vite build --config src-ui/vite.config.ts",
    "check:versions": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const tauri=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8')); const meta=fs.readFileSync('src-ui/core/domain/app-meta.ts','utf8'); const app=meta.match(/APP_VERSION = '([^']+)'/); const label=meta.match(/APP_VERSION_LABEL = 'v([^']+)'/); const mismatches=[]; if(pkg.version!==tauri.version)mismatches.push('package.json != tauri.conf.json'); if(!app||pkg.version!==app[1])mismatches.push('package.json != APP_VERSION'); if(!label||pkg.version!==label[1])mismatches.push('package.json != APP_VERSION_LABEL'); if(mismatches.length){console.error(mismatches.join('\\n')); process.exit(1)} console.log('version metadata is consistent:', pkg.version)\"",
    "typecheck": "tsc -p src-ui/tsconfig.json --noEmit",
    "lint": "eslint src-ui",
    "lint:fix": "eslint src-ui --fix",
    "fmt": "pnpm run fmt:rust && pnpm run fmt:ui",
    "fmt:rust": "cargo fmt --all",
    "fmt:ui": "prettier --write \"src-ui/**/*.{ts,tsx,css}\"",
    "fmt:check": "cargo fmt --all -- --check && prettier --check \"src-ui/**/*.{ts,tsx,css}\"",
    "verify": "pnpm run ts-bindings && pnpm run typecheck && pnpm run lint && pnpm run rust:check && pnpm run fmt:check",
    "ts-bindings": "cargo test -p ncd-runtime --lib export_bindings_ -- --quiet && cargo test -p ncd-domain --lib export_bindings_ -- --quiet && cargo test -p ncd-component --lib export_bindings_ -- --quiet && cargo test -p ncd-appframework --lib export_bindings_ -- --quiet && cargo test -p ncd-deploy --lib export_bindings_ -- --quiet && cargo test -p ncd-host --lib export_bindings_ -- --quiet && cargo test -p ncd-server --lib export_bindings_ -- --quiet && cargo test -p ncd-tauri --lib export_bindings_ -- --quiet",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:msi": "tauri build --bundles msi",
    "icons:gen": "python scripts/generate_app_icons.py",
    "tauri:icon": "pnpm run icons:gen",
    "tauri:watch": "cargo watch --watch src-tauri/src --watch crates --ignore '**/*.md' --ignore 'target/**' --ignore 'src-ui/core/ipc/generated/**' --shell \"tauri dev\"",
    "release": "node scripts/release.mjs",
    "release:notes:draft": "node scripts/release-notes.mjs draft",
    "release:notes:preview": "node scripts/release-notes.mjs preview",
    "release:notes:render": "node scripts/release-notes.mjs render",
    "release:bump": "node scripts/release.mjs bump",
    "release:prepare": "node scripts/release.mjs prepare",
    "catalog:snapshots": "node scripts/onebot-catalog/build-snapshots.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.2.11",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  }
}
