{
  "name": "napcatqq-desktop-ui",
  "private": true,
  "version": "3.1.9",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --config src-ui/vite.config.ts",
    "test:unit": "vitest run --config src-ui/vitest.config.ts --dir src-ui",
    "build": "tsc -p src-ui/tsconfig.json && vite build --config src-ui/vite.config.ts",
    "check:versions": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const tauri=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8')); const meta=fs.readFileSync('src-ui/core/domain/app-meta.ts','utf8'); const app=meta.match(/APP_VERSION = '([^']+)'/); const label=meta.match(/APP_VERSION_LABEL = 'v([^']+)'/); const mismatches=[]; if(pkg.version!==tauri.version)mismatches.push('package.json != tauri.conf.json'); if(!app||pkg.version!==app[1])mismatches.push('package.json != APP_VERSION'); if(!label||pkg.version!==label[1])mismatches.push('package.json != APP_VERSION_LABEL'); if(mismatches.length){console.error(mismatches.join('\\n')); process.exit(1)} console.log('version metadata is consistent:', pkg.version)\"",
    "typecheck": "tsc -p src-ui/tsconfig.json --noEmit",
    "verify": "pnpm run ts-bindings && pnpm run typecheck && pnpm run rust:check",
    "ts-bindings": "cargo test -p ncd-runtime --lib export_bindings_ -- --quiet && cargo test -p ncd-domain --lib export_bindings_ -- --quiet && cargo test -p ncd-component --lib export_bindings_ -- --quiet && cargo test -p ncd-deploy --lib export_bindings_ -- --quiet && cargo test -p ncd-host --lib export_bindings_ -- --quiet && cargo test -p ncd-tauri --lib export_bindings_ -- --quiet",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:msi": "tauri build --bundles msi",
    "icons:gen": "python script/generate_app_icons.py",
    "tauri:icon": "tauri icon src-ui/assets/logo.png",
    "tauri:watch": "cargo watch --watch src-tauri/src --watch crates --ignore '**/*.md' --ignore 'target/**' --ignore 'src-ui/core/ipc/generated/**' --shell \"tauri dev\"",
    "release": "node scripts/release.mjs",
    "release:notes:draft": "node scripts/release-notes.mjs draft",
    "release:notes:preview": "node scripts/release-notes.mjs preview",
    "release:notes:render": "node scripts/release-notes.mjs render",
    "release:bump": "node scripts/release.mjs bump",
    "release:prepare": "node scripts/release.mjs prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  }
}
