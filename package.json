{
  "name": "napcatqq-desktop-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "pnpm run build:demo && astro dev --host 127.0.0.1",
    "build": "pnpm run build:demo && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:docs": "node --test scripts/docs-markdown.test.mjs scripts/docs-reading.test.mjs && node scripts/check-docs.mjs",
    "demo:plan": "node scripts/build-desktop-demo.mjs --dry-run",
    "demo:prepare": "node scripts/build-desktop-demo.mjs --prepare",
    "build:demo": "node scripts/build-desktop-demo.mjs",
    "test:demo": "node --test demo/*.test.mjs"
  },
  "dependencies": { "astro": "7.4.1", "@astrojs/markdown-satteri": "0.4.4" },
  "pnpm": {
    "overrides": { "@shikijs/vscode-textmate": "10.0.2" }
  }
}
