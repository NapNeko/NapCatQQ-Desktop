---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../components/DocsLayout.astro';
import { sortDocs } from '../../lib/docs';

export async function getStaticPaths() {
  const entries = sortDocs(await getCollection('docs'));
  return entries.map(entry => ({ params: { slug: entry.id === 'index' ? undefined : entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout entry={entry} entries={entries} headings={headings}>
  <Content />
</DocsLayout>
