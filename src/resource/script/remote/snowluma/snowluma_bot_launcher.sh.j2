#!/usr/bin/env bash
# SnowLuma 单 Bot (qq.exe spawn) 启停管理 (W2 契约).
#
# 由 src/core/remote/snowluma/templates.py:build_snowluma_bot_launcher 渲染.
# 子命令: start <qq_id> [uin] / stop <qq_id> / status <qq_id>
#
# 设计取舍:
#   - 远端 LinuxQQ 是 rootless 安装 (``dpkg -x`` 解到 ``$WORKSPACE_DIR``), 所以
#     qq 二进制实际位于 ``$WORKSPACE_DIR/opt/QQ/qq`` 而非 ``/usr/bin/qq``.
#     与 NC ``remote_napcat_launcher.sh`` 一致, 见 ``remote_install_linuxqq.sh``
#     L412-425 (``install_base_dir=$WORKSPACE_DIR``).
#   - DISPLAY=:{{display_num}} 让 qq 渲染到 daemon 的 Xvfb.
#   - qq_id 在 SnowLuma 概念里是登录会话 id (常等于 uin); 本脚本只用 qq_id 区分进程.
#   - uin (可选) 仅写入 status_bot 元数据, 便于 Desktop 侧 BotCard 显示.
set -euo pipefail
umask 077

# rootless LinuxQQ 路径 (与 NC napcat launcher 同模式: ${workspace_dir}/opt/QQ/qq).
# 允许通过 ``QQ_BIN`` env 覆盖, 兼容用户手工把 deb 装到系统 ``/opt/QQ`` 的场景.
QQ_BIN_DEFAULT="$WORKSPACE_DIR/opt/QQ/qq"

require_qq_id() {
    if [ -z "${1:-}" ]; then
        echo "缺少 qq_id 参数" >&2
        exit 64
    fi
    case "$1" in
        ''|*[!0-9]*)
            echo "qq_id 必须是纯数字: $1" >&2
            exit 64
            ;;
    esac
}

write_status_bot() {
    # $1=qq_id $2=uin(空串=null) $3=running(true/false)
    local qq_id="$1" uin="$2" running="$3"
    local pid started_at uin_field
    pid=$(cat "$RUNTIME_DIR/pid_bot_$qq_id" 2>/dev/null || echo null)
    started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -z "$uin" ]; then
        uin_field="null"
    else
        uin_field="\"$uin\""
    fi
    cat > "$RUNTIME_DIR/status_bot_$qq_id.json" <<EOF
{
  "qq_id": "$qq_id",
  "uin": $uin_field,
  "pid": $pid,
  "running": $running,
  "started_at": "$started_at"
}
EOF
}

cmd_start() {
    local qq_id="$1"
    local uin="${2:-}"
    require_qq_id "$qq_id"

    mkdir -p "$RUNTIME_DIR" "$LOG_DIR"

    # P8 (review): per-bot flock 互斥, 避免多个 SSH 会话同时 start 同一 qq_id 导致双 spawn.
    # 锁文件 per-qq_id (不阻塞别的 Bot 并发启动). FD 201 与 daemon launcher 的 200 隔离.
    exec 201> "$RUNTIME_DIR/.bot_start_${qq_id}.lock"
    if ! flock -n 201; then
        echo "bot $qq_id start: 已有另一个 start 在跑, 请等待" >&2
        return 75  # EX_TEMPFAIL
    fi

    # 幂等检查
    local pidfile="$RUNTIME_DIR/pid_bot_$qq_id"
    if [ -f "$pidfile" ]; then
        local existing
        existing=$(cat "$pidfile" 2>/dev/null || echo "")
        if [ -n "$existing" ] && kill -0 "$existing" 2>/dev/null; then
            write_status_bot "$qq_id" "$uin" true
            echo "bot $qq_id already running (pid=$existing)"
            return 0
        fi
        rm -f "$pidfile"
    fi

    local qq_bin="${QQ_BIN:-$QQ_BIN_DEFAULT}"
    if [ ! -x "$qq_bin" ]; then
        echo "qq 可执行文件不存在或无执行位: $qq_bin" >&2
        return 2
    fi

    # 远端 qq 必须有 daemon 提供的 DISPLAY
    if ! xdpyinfo -display ":{{display_num}}" >/dev/null 2>&1; then
        echo "Xvfb :{{display_num}} 未运行, 请先 start daemon" >&2
        # 非致命: 仍尝试启 (xdpyinfo 可能未装), 让后续日志暴露问题
    fi

    # SnowLuma ptrace inject 需要通过 /proc/PID/maps 定位 libgcc_s.so.1;
    # CentOS 9 等发行版上 QQ (Electron) 可能延迟加载 libgcc_s, 导致 inject 时
    # 在 maps 里找不到. LD_PRELOAD 强制预加载确保 maps 可见.
    #
    # W10c 深层根因: CentOS 9 上 /lib64/libgcc_s.so.1 是 symlink 指向
    # /lib64/libgcc_s-8-20210514.so.1 (带版本号的真实文件). 内核在 /proc/PID/maps
    # 中显示的是 **解析后的真实路径** (非 symlink 名), 所以 SnowLuma inject 代码
    # grep "libgcc_s.so.1" 在 maps 里匹配不到 (实际显示的是 libgcc_s-8-*.so.1).
    #
    # 解决方案: 把系统 symlink 替换为硬链接 (同 inode, 不占额外空间), 这样
    # 动态链接器 open() 的路径就是 /lib64/libgcc_s.so.1 (非 symlink 不会被解析),
    # maps 里显示的也是 /lib64/libgcc_s.so.1. 同时 LD_PRELOAD 确保 QQ 启动时加载它.
    local libgcc_path=""
    libgcc_path=$(ldconfig -p 2>/dev/null | grep -m1 'libgcc_s.so.1' | awk '{print $NF}') || true

    if [ -n "$libgcc_path" ] && [ -L "$libgcc_path" ]; then
        # symlink → 替换为硬链接 (需要 root; 当前用户就是 root)
        local real_path
        real_path=$(readlink -f "$libgcc_path")
        if [ -f "$real_path" ]; then
            rm -f "$libgcc_path" 2>/dev/null && \
                ln "$real_path" "$libgcc_path" 2>/dev/null || true
        fi
    fi

    # 重新获取路径 (可能已从 symlink 变为硬链接)
    libgcc_path=$(ldconfig -p 2>/dev/null | grep -m1 'libgcc_s.so.1' | awk '{print $NF}') || true

    # W10c fix: CentOS 9 / RHEL 9 默认 kernel.yama.ptrace_scope=1, 只允许父进程
    # ptrace 子进程. SnowLuma node 进程不是 QQ 的父进程, 导致 inject 时无法读取
    # /proc/PID/maps (即使 libgcc_s.so.1 已加载也报 "not visible"). 需要设为 0.
    if [ -f /proc/sys/kernel/yama/ptrace_scope ]; then
        local current_scope
        current_scope=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo "")
        if [ "$current_scope" != "0" ]; then
            sudo -n sysctl -w kernel.yama.ptrace_scope=0 >/dev/null 2>&1 || \
                echo "警告: 无法设置 ptrace_scope=0 (SnowLuma inject 可能失败)" >&2
        fi
    fi

    # 构建环境变量: LD_PRELOAD 强制预加载 libgcc_s
    local -a env_args=()
    if [ -n "$libgcc_path" ]; then
        env_args+=("LD_PRELOAD=$libgcc_path")
    fi

    DISPLAY=":{{display_num}}" nohup env "${env_args[@]}" "$qq_bin" --no-sandbox --disable-gpu-sandbox -q "$qq_id" \
        > "$LOG_DIR/bot_$qq_id.log" 2>&1 &
    echo $! > "$pidfile"
    sleep 0.5
    if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "bot $qq_id 启动后立即退出 (检查 $LOG_DIR/bot_$qq_id.log)" >&2
        rm -f "$pidfile"
        write_status_bot "$qq_id" "$uin" false
        return 3
    fi

    write_status_bot "$qq_id" "$uin" true
}

cmd_stop() {
    local qq_id="$1"
    require_qq_id "$qq_id"

    local pidfile="$RUNTIME_DIR/pid_bot_$qq_id"
    if [ -f "$pidfile" ]; then
        local pid
        pid=$(cat "$pidfile" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            local i=0
            while [ "$i" -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
                sleep 0.5
                i=$((i + 1))
            done
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$pidfile"
    fi
    write_status_bot "$qq_id" "" false
}

cmd_status() {
    local qq_id="$1"
    require_qq_id "$qq_id"

    local sf="$RUNTIME_DIR/status_bot_$qq_id.json"
    if [ -f "$sf" ]; then
        cat "$sf"
    else
        cat <<EOF
{"qq_id": "$qq_id", "uin": null, "pid": null, "running": false, "started_at": null}
EOF
    fi
}

case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    status)  shift; cmd_status "$@" ;;
    *)
        cat >&2 <<USAGE
Usage: $0 {start <qq_id> [uin] | stop <qq_id> | status <qq_id>}
USAGE
        exit 64
        ;;
esac
