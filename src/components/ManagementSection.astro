---
import '../styles/management.css';
const docs='https://github.com/NapNeko/NapCatQQ-Desktop/blob/main/docs/user/';
---
<section class="management-section section" id="management" aria-labelledby="management-title">
  <div class="container">
    <div class="section-heading"><div class="section-index">机器人与远端</div><h2 id="management-title">在这台电脑，<br />也在你的服务器。</h2><p>用同一套操作管理 NapCat 和 SnowLuma。组件、启停、登录与日志，按主机放在一起。</p></div>
    <div class="management-workspace">
      <div class="host-selector" role="group" aria-label="查看运行位置"><button type="button" aria-pressed="true" data-placement="local"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg><span><strong>本机 Windows</strong><small>在自己的电脑上运行</small></span><span class="host-selected" aria-hidden="true">✓</span></button><button type="button" aria-pressed="false" data-placement="remote"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="7" rx="2" /><rect x="3" y="14" width="18" height="7" rx="2" /><path d="M7 6.5h.1m0 11h.1M11 6.5h6m-6 11h6" /></svg><span><strong>远端 Linux</strong><small>通过 SSH 管理服务器</small></span><span class="host-selected" aria-hidden="true">✓</span></button><p class="host-selector-note">运行位置示意</p></div>
      <div class="management-detail" aria-live="polite"><div class="management-detail-top"><span class="host-connection"><span class="connection-dot"></span><span data-placement-label>本机 Windows</span></span><span class="protocols">NapCat <span>+</span> SnowLuma</span></div><div class="management-detail-content"><h3 data-placement-heading>准备好组件，就能开始。</h3><p data-placement-description>安装运行时、QQ 和协议端，再创建自己的 Bot。QQ 程序可以单独安装，日常使用的系统 QQ 也有清楚的选择入口。</p><div class="component-flow"><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 5v9l9 5 9-5V8m-9 5v9" /></svg>准备组件</span><i aria-hidden="true"></i><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="7" width="14" height="12" rx="3" /><path d="M12 3v4M9 12h.1m5.9 0h.1M9 16h6" /></svg>创建 Bot</span><i aria-hidden="true"></i><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg>启动登录</span></div><a class="text-link" data-placement-link href={`${docs}README.md`}>查看本机使用指南 <span aria-hidden="true">↗</span></a></div><div class="management-bottom"><span data-placement-note>组件安装与 Bot 日志，各有进度可查。</span><span class="operation-points">启停 <span>／</span> 日志 <span>／</span> WebUI</span></div></div>
    </div>
    <div class="start-path" id="getting-started"><div><h3>第一次使用？从这三步开始。</h3><p>先准备环境，再让第一个 Bot 跑起来。</p></div><ol><li><span>1</span><div><strong>安装 Desktop</strong><small>下载 Windows 安装包</small></div></li><li><span>2</span><div><strong>准备组件</strong><small>选择主机与协议端</small></div></li><li><span>3</span><div><strong>启动并登录</strong><small>创建 Bot，完成扫码</small></div></li></ol></div>
  </div>
</section>
<script>
  const placements = {
    local:{label:'本机 Windows',heading:'准备好组件，就能开始。',description:'安装运行时、QQ 和协议端，再创建自己的 Bot。QQ 程序可以单独安装，日常使用的系统 QQ 也有清楚的选择入口。',note:'组件安装与 Bot 日志，各有进度可查。',link:'README.md',linkText:'查看本机使用指南'},
    remote:{label:'远端 Linux · SSH',heading:'连接服务器，接着在桌面里管理。',description:'添加 SSH 主机，检测与准备环境。支持原生运行与 Docker 部署；组件、部署任务、登录入口和日志都能按主机找到。',note:'远端运行，Desktop 负责连接、配置与管理。',link:'remote-linux.md',linkText:'查看远端使用指南'}
  };
  const workspace = document.querySelector<HTMLElement>('.management-workspace')!;
  workspace.querySelectorAll<HTMLButtonElement>('[data-placement]').forEach(button=>button.addEventListener('click',()=>{
    workspace.querySelectorAll('[data-placement]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    const view=placements[button.dataset.placement as keyof typeof placements];
    for(const [key,value] of Object.entries({label:view.label,heading:view.heading,description:view.description,note:view.note})){ workspace.querySelector(`[data-placement-${key}]`)!.textContent=value; }
    const link=workspace.querySelector<HTMLAnchorElement>('[data-placement-link]')!;
    link.href=`https://github.com/NapNeko/NapCatQQ-Desktop/blob/main/docs/user/${view.link}`;
    link.replaceChildren(document.createTextNode(`${view.linkText} ↗`));
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches)workspace.querySelector('.management-detail-content')!.animate([{opacity:.5,transform:'translateX(6px)'},{opacity:1,transform:'translateX(0)'}],{duration:230,easing:'ease-out'});
  }));
</script>
