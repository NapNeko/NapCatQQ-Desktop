---
import '../styles/tutorial-demo.css';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
import type { Tutorial } from '../lib/tutorials';

interface Props { tutorial: Tutorial }
const { tutorial } = Astro.props;
const base = import.meta.env.BASE_URL;
const version = createHash('sha256').update(readFileSync(resolve('public/demo/index.html'))).digest('hex').slice(0, 12);
const { steps } = tutorial;
const demoWidth = 1280;
const demoHeight = 720;
---

<div class="tutorial-demo-slot" data-tutorial-anchor>
  <section id="tutorial-demo" class="tutorial-demo" style={`--fbd-native-width:${demoWidth}px;--fbd-native-height:${demoHeight}px;--fbd-aspect:${demoWidth} / ${demoHeight}`} data-tutorial-demo data-demo-lesson={tutorial.id} data-demo-src={`${base}demo/index.html?v=${version}&lesson=${tutorial.id}`} data-mode="idle" data-expanded="false" role="region" aria-labelledby="tutorial-demo-title" aria-describedby="tutorial-demo-environment">
    <header class="fbd-topbar">
      <div class="fbd-heading"><svg class="fbd-window-mark" width="25" height="25" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 4 16 9 27 4v20a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V4Z" fill="currentColor"/><path d="m10 15 4 3-4 3m7 0h5" stroke="var(--panel)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><div><span class="fbd-label">交互演示</span><h2 id="tutorial-demo-title">{tutorial.title}</h2></div></div>
      <p class="fbd-environment" id="tutorial-demo-environment">{tutorial.environment}</p>
      <span class="fbd-mode" data-fbd-mode>未开始</span>
      <button class="fbd-close" type="button" data-fbd-close aria-label="关闭放大视图" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg><span>收起</span></button>
    </header>

    <div class="fbd-controls" role="group" aria-label="演示控制">
      <button class="fbd-primary" type="button" data-fbd-play>
        <svg data-fbd-play-icon width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6 3.5 16 10 6 16.5v-13Z" /></svg>
        <svg data-fbd-pause-icon width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" hidden><path d="M5 4h3v12H5zm7 0h3v12h-3z" /></svg>
        <span data-fbd-play-label>自动演示</span>
      </button>
      <button type="button" data-fbd-manual aria-pressed="false"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m5 2 10 9-5 .5-2.5 4.5L5 2Z" /></svg><span>自己操作</span></button>
      <span class="fbd-controls-spacer" aria-hidden="true"></span>
      <button class="fbd-utility" type="button" data-fbd-reset disabled><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5v4h4M4 9a6 6 0 1 1 1.5 5.5" /></svg><span>重置</span></button>
      <button class="fbd-utility" type="button" data-fbd-expand aria-haspopup="dialog" aria-expanded="false" aria-controls="tutorial-demo"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8V3h5m4 0h5v5M3 12v5h5m4 0h5v-5" /></svg><span data-fbd-expand-label>放大</span></button>
    </div>

    <div class="fbd-viewport" data-fbd-viewport tabindex="0" role="region" aria-label="软件演示窗口">
      <div class="fbd-canvas" data-fbd-canvas>
        <iframe class="fbd-frame" data-fbd-frame title={`NapCatQQ Desktop：${tutorial.summary}`} width={demoWidth} height={demoHeight} sandbox="allow-scripts allow-same-origin allow-forms" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>
        <div class="fbd-cover" data-fbd-cover>
          <img class="fbd-poster-light" src={`${base}docs/screenshots/${tutorial.poster}-light.png`} alt={`${tutorial.title}界面预览`} width={demoWidth} height={demoHeight} loading="lazy" decoding="async" draggable="false" />
          <img class="fbd-poster-dark" src={`${base}docs/screenshots/${tutorial.poster}-dark.png`} alt={`${tutorial.title}界面预览，深色主题`} width={demoWidth} height={demoHeight} loading="lazy" decoding="async" draggable="false" />
        </div>
      </div>
      <div class="fbd-loading" data-fbd-loading hidden><span class="fbd-loading-mark" aria-hidden="true"></span><p>正在加载演示…</p></div>
    </div>
    <p class="fbd-pan-hint" data-fbd-pan hidden>左右滑动查看窗口，或点「放大」。</p>

    <ol class="fbd-steps" aria-label="演示步骤">
      {steps.map((step, index) => <li data-fbd-step={index}><span aria-hidden="true">0{index + 1}</span><span>{step}</span></li>)}
    </ol>
    <div class="fbd-status" aria-live="polite" aria-atomic="true">
      <div><span data-fbd-position>准备开始</span><strong data-fbd-title>{tutorial.summary}</strong></div>
      <p data-fbd-detail>先看一遍，或直接上手。</p>
    </div>
    <p class="fbd-error" data-fbd-error role="alert" hidden></p>

    <noscript><p class="fbd-noscript">交互演示需要启用 JavaScript。下方有完整图文步骤。</p></noscript>
  </section>
</div>

<script>
  import '../scripts/tutorial-demo';
</script>
