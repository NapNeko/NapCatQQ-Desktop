---
import '../styles/product-sections.css';

const media = import.meta.env.BASE_URL + 'media/';
const guides = import.meta.env.BASE_URL + 'docs/';
const frameworks = [
  {
    id: 'karin', name: 'Karin', title: '配置与插件管理',
    description: '支持框架配置编辑、插件安装和 OneBot 对接。',
    features: ['编辑框架配置', '安装与管理插件', '对接 OneBot 连接'],
  },
  {
    id: 'nonebot', name: 'NoneBot2', title: '适配器与插件管理',
    description: '可新建实例或导入已有项目，编辑连接配置。',
    features: ['管理适配器', '浏览插件商店', '编辑连接配置'],
  },
  {
    id: 'astrbot', name: 'AstrBot', title: '模型、人格与知识库',
    description: '编辑模型提供商、人格、知识库、会话和插件配置。',
    features: ['配置模型提供商与人格', '管理知识库与会话', '调整插件配置'],
  },
  {
    id: 'maibot', name: 'MaiBot（麦麦）', title: '配置与学习数据管理',
    description: '可调整模型、提示词与学习数据，并通过试聊检查效果。',
    features: ['编辑框架与模型配置', '管理提示词和学习数据', '打开试聊'],
  },
  {
    id: 'koishi', name: 'Koishi', title: '配置表单与插件树',
    description: '按插件树查看与编辑配置，并管理连接。',
    features: ['编辑配置表单', '查看与管理插件树', '管理连接'],
  },
  {
    id: 'yunzai', name: 'TRSS-Yunzai（云崽）', title: '实例管理与 OneBot 对接',
    description: '创建或导入云崽实例，编辑框架配置与 Bot 连接。',
    features: ['管理应用实例', '编辑框架配置', '对接 OneBot 连接'],
  },
  {
    id: 'neobot', name: 'NeoBot', title: '模型配置与运行面板',
    description: '配置模型、提示词、记忆和插件，查看运行状态与用量。',
    features: ['配置模型、提示词与记忆', '管理插件', '查看运行与用量面板'],
  },
];
const chatModes = [
  {
    id: 'conversations', name: '私聊与群聊', summary: '按账号管理联系人与消息',
    description: '支持好友分组、置顶、未读筛选和聊天记录搜索。消息可回复、@、撤回自己发送的内容，也可逐条或合并转发。',
    note: '图片和文件可拖入或粘贴到输入框。',
    path: 'M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l-3 3v-10a7.5 7.5 0 0 1 15-1',
  },
  {
    id: 'files', name: '媒体与群文件', summary: '媒体预览与群文件管理',
    description: '查看图片、语音、视频、Markdown 与转发记录。群文件支持浏览、上传和下载；有相应权限时，也能管理文件与目录。',
    note: '群文件管理依账号权限提供。',
    path: 'M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z',
  },
  {
    id: 'capture', name: '原生截图', summary: '标注与滚动长截图',
    description: '支持框选、标注、撤销重做和双向滚动长截图。截图可加入聊天草稿，也可只复制或保存。',
    note: '默认快捷键为 Ctrl + Alt + S，可修改。',
    path: 'M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3M8 8h8v8H8Z',
  },
];
---

<section id="applications" class="section product-apps" aria-labelledby="applications-heading">
  <div class="container">
    <header class="section-heading product-section-heading">
      <div>
        <h2 id="applications-heading">应用端管理</h2>
        <p>支持新建或导入实例，管理启停、日志、配置及 Bot 对接。</p>
      </div>
      <a class="product-guide-link" href={guides + 'apps/'}>
        应用端使用指南
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </a>
    </header>

    <div class="framework-selector" role="group" aria-label="选择应用端框架">
      {frameworks.map((framework, index) => (
        <button
          type="button"
          id={'framework-' + framework.id}
          data-framework={framework.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls={'framework-panel-' + framework.id}
        >
          <span class="framework-marker" aria-hidden="true"></span>
          {framework.name}
        </button>
      ))}
    </div>

    <div class="apps-product-layout">
      <figure class="apps-product-figure">
        <div class="product-window apps-product-window">
          <img src={media + 'apps.png'} alt="NapCatQQ Desktop 应用端管理页演示，显示实例列表与管理入口" width="1440" height="900" loading="lazy" decoding="async" />
        </div>
        <figcaption>应用端管理 · 演示数据</figcaption>
      </figure>

      <div class="framework-details" aria-live="polite" aria-atomic="true">
        {frameworks.map((framework, index) => (
          <article id={'framework-panel-' + framework.id} data-framework-panel={framework.id} hidden={index !== 0} aria-labelledby={'framework-title-' + framework.id}>
            <span class="framework-name">{framework.name}</span>
            <h3 id={'framework-title-' + framework.id}>{framework.title}</h3>
            <p>{framework.description}</p>
            <ul class="framework-feature-list">
              {framework.features.map((feature) => (
                <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg>{feature}</li>
              ))}
            </ul>
          </article>
        ))}
        <p class="framework-availability">部分操作需要实例运行并连接 WebUI。一键对接暂不支持 Docker Bot。</p>
      </div>
    </div>

    <div class="apps-lifecycle" aria-label="应用端管理流程">
      <div><span>准备环境</span><p>在组件页安装运行时与框架。</p></div>
      <svg viewBox="0 0 32 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h28m-6-6 6 6-6 6" /></svg>
      <div><span>管理实例</span><p>新建实例，或导入已有项目。</p></div>
      <svg viewBox="0 0 32 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h28m-6-6 6 6-6 6" /></svg>
      <div><span>连接 Bot</span><p>配置对接，查看连接和日志。</p></div>
    </div>
  </div>
</section>

<script>
  const applicationsSection = document.querySelector<HTMLElement>('#applications');
  const frameworkButtons = applicationsSection?.querySelectorAll<HTMLButtonElement>('[data-framework]');
  const frameworkPanels = applicationsSection?.querySelectorAll<HTMLElement>('[data-framework-panel]');

  frameworkButtons?.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.framework;
      frameworkButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      frameworkPanels?.forEach((panel) => { panel.hidden = panel.dataset.frameworkPanel !== selected; });
    });
  });

  const chatSection = document.querySelector<HTMLElement>('#chat');
  const chatButtons = chatSection?.querySelectorAll<HTMLButtonElement>('[data-chat-mode]');
  const chatPanels = chatSection?.querySelectorAll<HTMLElement>('[data-chat-panel]');
  const chatFigure = chatSection?.querySelector<HTMLElement>('[data-chat-focus]');

  chatButtons?.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.chatMode;
      chatButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      chatPanels?.forEach((panel) => { panel.hidden = panel.dataset.chatPanel !== selected; });
      if (chatFigure && selected) chatFigure.dataset.chatFocus = selected;
    });
  });
</script>

<section id="chat" class="section product-chat" aria-labelledby="chat-heading">
  <div class="container">
    <header class="section-heading product-section-heading">
      <div>
        <h2 id="chat-heading">聊天与截图</h2>
        <p>按 Bot 账号管理私聊和群聊，支持媒体消息、群文件与原生截图。</p>
      </div>
      <a class="product-guide-link" href={guides + 'chat/'}>
        聊天与截图指南
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </a>
    </header>

    <div class="chat-feature-selector" role="group" aria-label="了解聊天功能">
      {chatModes.map((mode, index) => (
        <button type="button" id={'chat-choice-' + mode.id} data-chat-mode={mode.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={'chat-panel-' + mode.id}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={mode.path} /></svg>
          <span><strong>{mode.name}</strong><span>{mode.summary}</span></span>
        </button>
      ))}
    </div>

    <div class="chat-detail-row">
      <div class="chat-feature-details" aria-live="polite" aria-atomic="true">
        {chatModes.map((mode, index) => (
          <div id={'chat-panel-' + mode.id} data-chat-panel={mode.id} hidden={index !== 0} aria-labelledby={'chat-choice-' + mode.id}>
            <p>{mode.description}</p>
            <span class="chat-feature-note">{mode.note}</span>
          </div>
        ))}
      </div>
      <div class="chat-shortcut"><span>截图快捷键</span><div><kbd>Ctrl</kbd><span>+</span><kbd>Alt</kbd><span>+</span><kbd>S</kbd></div></div>
    </div>

    <figure class="chat-product-figure" data-chat-focus="conversations">
      <div class="chat-product-stage">
        <div class="product-window chat-product-window">
          <img src={media + 'chat.png'} alt="NapCatQQ Desktop 聊天页演示，包含联系人列表、会话与消息输入区" width="1440" height="900" loading="lazy" decoding="async" />
        </div>
      </div>
      <figcaption>聊天工作区 · 演示数据</figcaption>
    </figure>
    <p class="chat-account-note">后台接收、头像托盘和消息提醒需按账号开启；群聊可单独设置免打扰。</p>
  </div>
</section>
