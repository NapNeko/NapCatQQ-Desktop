---
import '../styles/story.css';
import { imageAsset } from '../../scripts/image-assets.mjs';
const base = import.meta.env.BASE_URL;
const chapters = [
  { id: 'connect', number: '01', word: '上线', title: '让第一只 Bot 上线。', copy: '准备组件、创建实例、扫码登录。本机和远端，都从这里开始。', href: 'first-bot/', link: '创建第一个 Bot', file: 'terminal.png', alt: 'Bot 实例与运行终端，使用演示数据', tags: ['准备组件', '扫码登录', '查看状态'] },
  { id: 'create', number: '02', word: '接入', title: '给 Bot 添点本事。', copy: '装好应用端，再连上 Bot。Karin、NoneBot2、AstrBot 等七种框架，在同一处管理。', href: 'apps/', link: '安装与配置应用端', file: 'apps.png', alt: '七种框架的应用实例，使用演示数据', tags: ['安装框架', '配置插件', '对接 OneBot'] },
  { id: 'chat', number: '03', word: '开聊', title: '发条消息，试试看。', copy: '直接收发私聊和群聊消息。图片、文件、截图，也在这个窗口里。', href: 'chat/', link: '聊天与截图教程', file: 'chat.png', alt: '多账号聊天界面，使用演示数据', tags: ['私聊与群聊', '媒体与文件', '原生截图'] },
];
---
<section id="story" class="workflow-story" aria-labelledby="story-title">
  <div class="story-stage">
    <div class="container">
      <header class="story-heading">
        <h2 id="story-title">从启动，到开聊。</h2>
        <nav class="story-nav" aria-label="使用流程">
          {chapters.map((chapter, index) => <a href={'#story-' + chapter.id} data-story-jump={index} aria-current={index === 0 ? 'step' : undefined}><span>{chapter.number}</span>{chapter.word}</a>)}
        </nav>
      </header>
      <div class="story-viewport">
        <div class="story-track">
          {chapters.map((chapter) => (
            <article id={'story-' + chapter.id} class={'story-panel story-panel-' + chapter.id}>
              <span class="story-watermark" aria-hidden="true">{chapter.word}</span>
              <div class="story-copy">
                <span class="story-step">第 {Number(chapter.number)} 步</span>
                <h3>{chapter.title}</h3>
                <p>{chapter.copy}</p>
                <a href={base + 'docs/' + chapter.href}>{chapter.link}<span aria-hidden="true">↗</span></a>
              </div>
              <div class="story-visual">
                <svg class="story-wire" viewBox="0 0 700 480" fill="none" aria-hidden="true"><path d="M0 420H115Q175 420 175 360V125Q175 65 235 65H640" pathLength="1" /><circle cx="640" cy="65" r="6" /></svg>
                <figure>
                  <img {...imageAsset('docs/screenshots/' + chapter.file.replace('.png', '-light.png'), base)} sizes="(max-width: 900px) 90vw, 60vw" width="1440" height="1000" alt={chapter.alt} loading="lazy" decoding="async" />
                  <figcaption>软件界面 · 演示数据</figcaption>
                </figure>
                <ul class="story-tags">{chapter.tags.map(tag => <li>{tag}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="story-bottom"><span>三步，开始使用。</span><div class="story-progress" aria-hidden="true"><span></span></div><a href="#management">往下看看，还有什么 <span aria-hidden="true">↓</span></a></div>
    </div>
  </div>
</section>
