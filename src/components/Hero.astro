---
import '../styles/hero.css';
import '../styles/home-demo.css';
import HeroArtwork from './HeroArtwork.astro';
import TutorialDemo from './TutorialDemo.astro';
import { tutorialForDoc } from '../lib/tutorials';
import { getChangelog } from '../lib/changelog';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/NapNeko/NapCatQQ-Desktop';
const latestRelease = (await getChangelog()).find(release => release.product === 'desktop' && release.latest);
const choices = [
  { label: '应用端', tutorial: { ...tutorialForDoc('apps')!, poster: 'apps' } },
  { label: '机器人', tutorial: tutorialForDoc('bots')! },
  { label: '聊天', tutorial: tutorialForDoc('chat')! },
  { label: '调试台', tutorial: tutorialForDoc('debugging')! },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-scene">
    <div class="hero-tint" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <svg class="hero-circuit" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M-60 700H130Q210 700 210 620V570Q210 490 290 490H1040Q1160 490 1160 370V240Q1160 120 1280 120H1500" pathLength="1" /><path d="M-60 730H145Q240 730 240 635V600Q240 520 320 520H1070Q1190 520 1190 400V270Q1190 150 1310 150H1500" pathLength="1" /></svg>
    <div class="container hero-canvas">
      <div class="hero-signature">
        <p class="hero-product" data-hero-reveal><span></span>NapCat / SnowLuma 桌面控制台</p>
        <h1 id="hero-title" aria-label="NapCatQQ Desktop"><span class="hero-word-mask" aria-hidden="true"><span class="hero-word">NapCatQQ</span></span><span class="hero-word-mask" aria-hidden="true"><span class="hero-word hero-word-outline">Desktop<span class="hero-period">.</span></span></span></h1>
        <div class="hero-intro" data-hero-reveal>
          <p class="hero-statement">你的 Bot，都在这里。</p>
          <p class="hero-description">从第一次上线，到每天的聊天、部署与调试。<br />在一个桌面窗口里完成。</p>
          <div class="hero-actions">
            <a class="button hero-download" href={repo + '/releases/latest'}><svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 3.2 7 2.4v5H1zm7-1L15 1v6.4H8zM1 8.4h6v5l-6-.8zm7 0h7V15l-7-1.2z" /></svg> 下载 Windows 版 <span class="download-arrow" aria-hidden="true">↗</span></a>
            <a class="hero-guide" href={base + 'docs/first-bot/'}>跟着教程开始 <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-system">Windows 10 / 11 x64 <span>免费开源</span>{latestRelease && <a class="hero-release" href={`${base}changelog/#${latestRelease.tag}`}>{latestRelease.tag} 更新日志 <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" /></svg></a>}</p>
        </div>
      </div>
      <HeroArtwork />
    </div>
    <div class="hero-preview-wrap">
      <div class="workspace-preview">
        <TutorialDemo id="home-desktop" tutorial={choices[0].tutorial} showcase eager choices={choices} />
      </div>
      <div class="hero-preview-controls">
        <p class="workspace-description"><span class="demo-live-dot" aria-hidden="true"></span>真实界面，可以动手试试。</p>
        <span class="preview-label">演示数据 · 不会连接 QQ</span>
      </div>
    </div>
    <div class="container hero-footnote">
      <a class="hero-explore" href="#story"><span class="explore-arrow" aria-hidden="true">↓</span> 滚动，展开工作台</a>
      <span class="hero-scroll-track" aria-hidden="true"><i></i></span>
      <button class="hero-replay" type="button" data-replay-opening>重播开场 <span aria-hidden="true">↻</span></button>
    </div>
  </div>
</section>
