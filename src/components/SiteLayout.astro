---
import '../styles/global.css';
import '../styles/home.css';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/NapNeko/NapCatQQ-Desktop';
---
<!doctype html>
<html lang="zh-CN" class="home-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2eb" />
    <title>NapCatQQ Desktop · NapCat / SnowLuma 桌面控制台</title>
    <meta name="description" content="NapCat / SnowLuma 的 Windows 桌面控制台。管理本机与远端 Bot、安装应用端、聊天与截图，使用 OneBot 调试台和内嵌终端。" />
    <link rel="icon" type="image/png" href={`${base}media/logo.png`} />
    <meta property="og:title" content="NapCatQQ Desktop · NapCat / SnowLuma 桌面控制台" />
    <meta property="og:description" content="支持本机与远端 Bot 管理、应用端配置、聊天、截图和 OneBot 调试。" />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="reading-progress" aria-hidden="true"></div>
      <nav class="container nav-inner" aria-label="主导航">
        <a class="brand" href={base} aria-label="NapCatQQ Desktop 首页"><img src={`${base}media/logo.png`} width="34" height="34" alt="" /><span>NapCatQQ <span class="brand-desktop">Desktop</span></span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">菜单 <span aria-hidden="true">＋</span></button>
        <div id="main-nav" class="main-nav">
          <details class="feature-menu"><summary>功能 <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.3" /></svg></summary>
            <div class="feature-menu-list"><a href="#management">Bot 与远端管理</a><a href="#applications">应用端管理</a><a href="#chat">聊天与截图</a><a href="#tools">OneBot 调试与终端</a><a href="#watch">远端监控</a></div>
          </details>
          <a href={`${base}docs/`}>使用文档</a>
          <a href={`${repo}/releases`}>更新日志</a>
          <a class="github-link" href={repo} aria-label="GitHub 源码"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.57 9.57 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg><span>GitHub</span></a>
          <a class="button button-small" href={`${repo}/releases/latest`}>下载 Windows 版</a>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main"><div><a class="brand" href={base}><img src={`${base}media/logo.png`} width="30" height="30" alt="" /><span>NapCatQQ Desktop</span></a><p>NapCat / SnowLuma 的 Windows 桌面控制台。</p></div><div class="footer-links"><a href={`${base}docs/`}>文档</a><a href={`${repo}/issues`}>问题反馈</a><a href="https://qm.qq.com/q/8UK5ecfDyw">QQ 交流群</a><a href={`${repo}/blob/main/CONTRIBUTING.md`}>参与开发</a></div></div>
      <div class="container footer-bottom"><span>开源许可证：<a href={`${repo}/blob/main/LICENSE`}>GPL-3.0</a></span><span>感谢 NapCat、SnowLuma 和各应用端项目。</span></div>
    </footer>
    <dialog id="image-viewer" class="image-viewer" aria-label="软件界面大图"><button type="button" class="viewer-close" aria-label="关闭大图">关闭 <kbd>Esc</kbd></button><img width="1440" height="900" alt="" /><p></p></dialog>
    <script>
      import '../scripts/home-motion';
    </script>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      document.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (target.closest('a[href^="#"]')) {
          toggle?.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('is-open');
          document.querySelector<HTMLDetailsElement>('.feature-menu')?.removeAttribute('open');
        }
      });
      const viewer = document.querySelector<HTMLDialogElement>('#image-viewer');
      document.addEventListener('click', (event) => {
        const trigger = (event.target as Element).closest<HTMLElement>('[data-lightbox]');
        if (!trigger || !viewer) return;
        const src = trigger.dataset.lightboxSrc || trigger.querySelector('img')?.getAttribute('src');
        if (!src) return;
        event.preventDefault();
        const img = viewer.querySelector('img')!;
        img.src = src;
        img.alt = trigger.dataset.lightboxAlt || trigger.querySelector('img')?.alt || '软件界面';
        viewer.querySelector('p')!.textContent = `${img.alt} · 演示数据`;
        viewer.showModal();
      });
      viewer?.querySelector('button')?.addEventListener('click', () => viewer.close());
      viewer?.querySelector('img')?.addEventListener('click', () => viewer.close());
      viewer?.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
        document.querySelector<HTMLDetailsElement>('.feature-menu')?.removeAttribute('open');
      });
    </script>
  </body>
</html>
