---
import '../styles/everyday.css';
import FeatureArt from './FeatureArt.astro';
import TutorialDemo from './TutorialDemo.astro';
import { appearanceTutorial } from '../lib/home-tutorials';
import { tutorialForDoc } from '../lib/tutorials';
import { imageAsset } from '../../scripts/image-assets.mjs';
const repo = 'https://github.com/NapNeko/NapCatQQ-Desktop';
const base = import.meta.env.BASE_URL;
const settings = tutorialForDoc('settings')!;
const backup = tutorialForDoc('backup')!;
const questions = [
  { title: '支持哪些操作系统？', answer: '客户端面向 Windows x64，支持 Windows 10 / 11 及 Windows Server 2016+。需要 WebView2；内嵌终端对系统版本另有要求，详见安装指南。', link: base + 'docs/installation/', label: '下载与安装' },
  { title: '可以管理服务器上的 Bot 吗？', answer: '可以通过 SSH 管理远端 Linux，支持原生运行与 Docker 部署。环境准备和登录步骤见远端指南。', link: base + 'docs/remote-linux/', label: '远端使用指南' },
  { title: '退出 Desktop 后，远端 Bot 会停止吗？', answer: '远端 Bot 可以继续运行。安装并配置 ncd-watch 后，Desktop 退出后仍可监控远端并发送通知。', link: base + 'docs/watch/', label: '远端值守' },
  { title: '如何反馈问题？', answer: '先查看用户指南与 Bot 日志。提交 Issue 时请附上版本、运行方式和复现步骤。', link: repo + '/issues', label: 'GitHub Issues' },
];
---
<section class="section everyday-section" id="settings" aria-labelledby="everyday-title">
  <div class="container">
    <span class="chapter-ghost" aria-hidden="true">06</span>
    <div class="section-heading">
      <div class="section-index">Desktop 设置</div>
      <h2 id="everyday-title" data-chapter="06 / MAKE IT YOURS">外观与数据设置</h2>
      <p>换个配色，整理侧栏。设置改好，点保存就生效。</p>
    </div>
    <div class="home-settings-demo">
      <TutorialDemo id="home-settings-demo" tutorial={appearanceTutorial} showcase choices={[{ label: '明暗与侧栏', tutorial: appearanceTutorial }, { label: '功能开关', tutorial: settings }, { label: '缓存清理', tutorial: backup }]} />
    </div>
    <div class="settings-support">
      <article><span class="support-number" aria-hidden="true">01</span><h3>按账号接收消息</h3><p>后台接收、头像托盘和消息提醒，都可以按账号开启。</p><a href={base + 'docs/chat/'}>聊天设置 ↗</a></article>
      <article><span class="support-number" aria-hidden="true">02</span><h3>备份配置，迁移数据</h3><p>导出配置或迁移数据目录。配置备份不包含程序与聊天记录。</p><a href={base + 'docs/backup/'}>查看备份范围 ↗</a></article>
      <article><span class="support-number" aria-hidden="true">03</span><h3>快捷键随手改</h3><p>截图默认使用 Ctrl + Alt + S，可在设置中更换。</p><a href={base + 'docs/settings/'}>外观与功能设置 ↗</a></article>
    </div>
  </div>
</section>
<section class="get-started-section" aria-labelledby="download-title">
  <div class="container">
    <FeatureArt kind="download" />
    <div class="download-eyebrow"><span>NAPCATQQ DESKTOP / DOWNLOAD</span><span>WINDOWS x64 / OPEN SOURCE</span></div>
    <div class="download-panel">
      <div>
        <img src={imageAsset('media/logo.png', base).src} width="64" height="64" alt="" loading="lazy" decoding="async" />
        <h2 id="download-title">下载 NapCatQQ Desktop</h2>
        <p>适用于 Windows x64，安装前可先阅读使用指南。</p>
        <div class="download-actions"><a class="button" href={repo + '/releases/latest'}>下载 Windows 安装包</a><a class="text-link" href={base + 'docs/'}>使用指南 ↗</a></div>
        <a class="release-link" href={base + 'changelog/'}>更新日志</a>
      </div>
      <div class="download-faq" data-home-faq>
        <div class="faq-questions" role="tablist" aria-label="下载前的常见问题" aria-orientation="vertical">
          {questions.map((question, index) => <button type="button" id={'download-question-' + index} role="tab" aria-controls={'download-answer-' + index} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-faq-question={index}><span>{question.title}</span><span aria-hidden="true">↗</span></button>)}
        </div>
        <div class="faq-answers">
          {questions.map((question, index) => <div id={'download-answer-' + index} role="tabpanel" aria-labelledby={'download-question-' + index} tabindex="0" data-faq-answer={index} hidden={index !== 0}><span class="faq-answer-index" aria-hidden="true">{String(index + 1).padStart(2, '0')} / 04</span><p>{question.answer}</p><a href={question.link}>{question.label} ↗</a></div>)}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const root = document.querySelector('[data-home-faq]');
  const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-faq-question]') ?? []);
  const panels = root?.querySelectorAll<HTMLElement>('[data-faq-answer]');
  function select(index: number) {
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels?.forEach((panel, i) => { panel.hidden = i !== index; });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(index));
    tab.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowDown') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault(); select(next); tabs[next].focus({ preventScroll: true });
    });
  });
</script>
