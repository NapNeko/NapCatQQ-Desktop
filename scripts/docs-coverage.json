  "methodology": {
    "unit": "One concrete user task or a closely related group of controls; framework-specific workflows are separate capabilities.",
    "basis": [
      "main/docs/user/*.md",
      "main/src-ui/shared/components/next/Sidebar.tsx",
      "main/src-ui/modules settings sections and framework navigation"
    ],
    "covered_definition": "Documentation explains the action, relevant prerequisites or limits, and enough concrete steps or UI labels for a user to attempt it. A navigation name alone is insufficient.",
    "counting": "covered / all capabilities. partial and missing are excluded from the numerator. Entries are not weighted by clicks, individual fields or lines of code.",
    "keyword_check": "All keywords must remain present in the combined named Markdown pages. This detects accidental deletion; human review determines status and factual accuracy.",
    "execution_boundary": "This is documentation coverage, not tested production functionality. Browser screenshots use the project preview fixtures; no real QQ login, SSH host, native Windows capture or paid model execution is claimed."
  },
  "exclusions": [
    {
      "area": "Developer APIs and implementation internals",
      "reason": "Rust command internals, schemas, adapters and every upstream OneBot endpoint are outside the Desktop user manual. The debug workflow is included."
    },
    {
      "area": "Third-party plugin and model service field reference",
      "reason": "Upstream plugin-specific configuration and model billing semantics vary independently. Desktop install/configure workflows and credentials/models are included."
    },
    {
      "area": "Native Windows-only screenshot imagery",
      "reason": "Screenshot selection overlay, native system tray and OS installation dialogs require Windows to capture honestly. Their user workflows remain in the capability denominator; missing imagery is tracked separately."
    },
    {
      "area": "Real-account and remote-machine acceptance testing",
      "reason": "No account, private host or service credentials were supplied. Tutorial validation describes checks for users to perform and does not imply those external operations were executed."
    }
  ],
